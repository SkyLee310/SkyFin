# SkyFin environment variables (TECH_SPEC §6). This file keeps names only.
# Copy it to .env.local and fill in the values there.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# Production values go in Vercel → Project Settings → Environment Variables.

# Supabase: project dashboard → Connect, or Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...); safe in the browser because RLS guards every table
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses RLS: cron route only
SUPABASE_SECRET_KEY=

# Gemini on Vertex AI (D22): Google Cloud project ID, and Vertex AI location (default global)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Service-account key JSON as one base64 line (the account has only the Vertex AI User role).
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_KEY=
# Model ID; default gemini-3.5-flash
GEMINI_MODEL=

# Bearer token for /api/cron/daily: a long random string, same value in Vercel
CRON_SECRET=

# Web Push: generate the pair with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
